<h1 style="text-align: center; margin-bottom: 30px;">Quiz Submissions Report</h1>

<table style="width: 100%; border-collapse: collapse; font-family: Arial, sans-serif; font-size: 12px;">
  <thead>
    <tr style="background-color: #f2f2f2;">
      <th style="border: 1px solid #ccc; padding: 8px;">ID</th>
      <th style="border: 1px solid #ccc; padding: 8px;">Name</th>
      <th style="border: 1px solid #ccc; padding: 8px;">Email</th>
      <th style="border: 1px solid #ccc; padding: 8px;">Correct</th>
      <th style="border: 1px solid #ccc; padding: 8px;">Wrong</th>
      <th style="border: 1px solid #ccc; padding: 8px;">Unanswered</th>
      <th style="border: 1px solid #ccc; padding: 8px;">Total Questions</th>
      <th style="border: 1px solid #ccc; padding: 8px;">Status</th>
      <th style="border: 1px solid #ccc; padding: 8px;">Submitted At</th>
    </tr>
  </thead>
  <tbody>
    <% @submissions.each do |submission| %>
      <tr>
        <td style="border: 1px solid #ccc; padding: 8px;"><%= submission.id %></td>
        <td style="border: 1px solid #ccc; padding: 8px;"><%= submission.user.name %></td>
        <td style="border: 1px solid #ccc; padding: 8px;"><%= submission.user.email %></td>
        <td style="border: 1px solid #ccc; padding: 8px;"><%= submission.correct_answers %></td>
        <td style="border: 1px solid #ccc; padding: 8px;"><%= submission.wrong_answers %></td>
        <td style="border: 1px solid #ccc; padding: 8px;"><%= submission.unanswered %></td>
        <td style="border: 1px solid #ccc; padding: 8px;">
          <%= submission.correct_answers + submission.wrong_answers + submission.unanswered %>
        </td>
        <td style="border: 1px solid #ccc; padding: 8px;"><%= submission.status.capitalize %></td>
        <td style="border: 1px solid #ccc; padding: 8px;"><%= submission.submission_time.strftime("%d %b %Y, %I:%M %p") %></td>
      </tr>
    <% end %>
  </tbody>
</table>
